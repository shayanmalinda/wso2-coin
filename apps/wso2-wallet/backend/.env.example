# Exact allowed origin for cross-origin requests. Leave empty to disable
# cross-origin responses (deny by default); do not use "*" in deployed envs.
CORS_ALLOWED_ORIGIN=

# JWT verification. Set JWT_JWKS_URL to the identity provider's JWKS endpoint so
# token signatures are verified (required for every deployed environment).
# JWT_ISSUER/JWT_AUDIENCE, when set, are additionally checked against the token's
# iss/aud claims. If JWT_JWKS_URL is empty the service refuses to start unless
# JWT_ALLOW_INSECURE=true — local development only, where tokens are decoded but
# not verified.
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALLOW_INSECURE=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wso2_wallet
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=25
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# AES-256 key, 32 bytes base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# One-time allocation granted on a user's first wallet.
INITIAL_COINS_ENABLED=true
INITIAL_COINS_AMOUNT=10
INITIAL_COINS_FUNDING_WALLET=

# The organization's email domain. Only its members get the initial coin grant, and
# wallet sharing is limited to it: both the owner and the person given access must
# belong to it. Defaults to wso2.com when unset.
# Change this when the organization's email domain changes, e.g. to choreolabs.com
# after the rebrand.
COMPANY_EMAIL_DOMAIN=wso2.com

# HR entity (GraphQL), used to search employees by name when sharing a wallet.
# Optional: leave PEOPLE_API_URL empty to turn the search off, and people are then
# added by typing their email. Once it is set, the token URL, client ID and client
# secret are required. Both URLs must be HTTPS unless they point at localhost.
PEOPLE_API_URL=
PEOPLE_TOKEN_URL=
PEOPLE_CLIENT_ID=
PEOPLE_CLIENT_SECRET=
PEOPLE_SCOPES=
# GraphQL EmployeeFilter (JSON) that selects active employees. The default is
# {"employeeStatus": ["Active"]}; some HR entity versions use {"isActive": true}.
PEOPLE_EMPLOYEE_FILTER=

# Maintenance mode. When true, the app shows a maintenance screen carrying
# MAINTENANCE_MESSAGE. Toggling requires updating these values and restarting.
MAINTENANCE_MODE=true
MAINTENANCE_MESSAGE=This is a test message
